{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "function": "app",
          "region": "us-west1"
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Referrer-Policy",
              "value": "no-referrer"
            }
          ]
        }
      ]
    },
    "firestore": {
      "rules": "firestore.rules"
    }
  }